# Editor and OS scratch. Named because each has already appeared untracked in a
# working tree that was about to be released.
.DS_Store
.idea/
brag-output/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# grask local state — transcripts and anything extracted from them contain the
# developer's own prompts and code, from every project on the machine. None of it
# belongs in this repository.
#
# The tools write under GRASK_HOME (~/.claude/grask) precisely so that no default
# path lands in a working tree. These patterns are the second line of defence for
# a run that was pointed here explicitly with --out.
out/
docs/measurements/
*.local.json
*.db
grask.log
triage-results.json
corpus-run*.txt
**/generated_probes.json
**/calibration_results*.json
**/boundary_results*.json

# demo recorder — local only; the GIF it produces is committed
docs/demo/

# Coverage is measured in CI against a floor; the local artifacts are not
# results worth keeping.
.coverage
.coverage.*
htmlcov/
